APP_ENV=cloud
DB_NAME=stock_intel
MONGO_URL=
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
POSTGRES_ENABLED=false
POSTGRES_DSN=postgresql://casecapital:CHANGE_ME@127.0.0.1:5432/casecapital
POSTGRES_POOL_MAX=5
EXECUTION_GATE_TRUTH_TIMEOUT_SECONDS=18
EXECUTION_GATE_REFRESH_FALLBACK_SECONDS=1800
CORS_ORIGINS=http://YOUR_SERVER_IP,https://YOUR_DOMAIN
PUBLIC_BASE_URL=http://YOUR_SERVER_IP

ENABLE_SCHEDULER=true
# Keep false until the cloud server is the ONLY execution authority.
ENABLE_TRADE_EXECUTION=false
DISABLE_CLAUDE_ANALYSIS=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SINGLE_CONSOLIDATED_SCAN_ONLY=true
ANTHROPIC_API_KEY=
FRED_API_KEY=
FINANCE_NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
SAM_GOV_API_KEY=
LSE_API_KEY=

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

OPTIONS_APCA_API_KEY_ID=
OPTIONS_APCA_API_SECRET_KEY=
OPTIONS_APCA_API_BASE_URL=https://paper-api.alpaca.markets
ENABLE_OPTIONS_EXECUTION=true
OPTIONS_ALLOW_INDICATIVE_EXECUTION=true
OPTIONS_FILTER_POLICY=standard
OPTIONS_TARGET_DELTA=0.55
OPTIONS_MAX_QUOTE_AGE_SECONDS=900
OPTIONS_MIN_OPEN_INTEREST=300
OPTIONS_MIN_VOLUME_WHEN_LOW_OI=100
OPTIONS_MIN_VOLUME_IF_OI_UNKNOWN=100
OPTIONS_MAX_SPREAD_ABS=0.75
OPTIONS_MAX_SPREAD_PCT=0.12
OPTIONS_MAX_INDICATIVE_SPREAD_PCT=0.25
OPTIONS_MIN_PREMIUM=0.05
OPTIONS_MIN_ABS_DELTA=0.35
OPTIONS_MAX_ABS_DELTA=0.75
OPTIONS_CONTRACT_LEARNING_AUTO_PROMOTE=false
OPTIONS_CONTRACT_LEARNING_LIVE_APPROVED=false
OPTIONS_ALPACA_REFRESH_LIMIT=18
