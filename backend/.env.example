MONGO_URL=mongodb://localhost:27017
DB_NAME=stock_intel
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
APP_ENV=local
ENABLE_SCHEDULER=true
# Keep false unless this instance is the single chosen execution authority.
ENABLE_TRADE_EXECUTION=false

# Required for new Claude analysis. Cached results and non-LLM endpoints can run without it.
ANTHROPIC_API_KEY=
# Set true to run scans with deterministic local analysis and make zero Claude API calls.
DISABLE_CLAUDE_ANALYSIS=false

# Optional Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_BASE_URL=

# Optional Alpaca paper trading and market data.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Optional separate Alpaca paper account for Options Desk.
OPTIONS_APCA_API_KEY_ID=
OPTIONS_APCA_API_SECRET_KEY=
OPTIONS_APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Optional data providers.
FINNHUB_API_KEY=
MASSIVE_API_KEY=
FRED_API_KEY=
FINANCE_NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
SAM_GOV_API_KEY=
REGULATIONS_GOV_API_KEY=
LSE_API_KEY=
