MONGO_URL=mongodb://localhost:27017
DB_NAME=stock_intel
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Optional Postgres durability/migration layer.
# Keep Mongo as primary until a subsystem cutover is explicitly completed.
POSTGRES_ENABLED=false
POSTGRES_DSN=postgresql://casecapital:CHANGE_ME@127.0.0.1:5432/casecapital
POSTGRES_POOL_MAX=5
EXECUTION_GATE_TRUTH_TIMEOUT_SECONDS=18
EXECUTION_GATE_REFRESH_FALLBACK_SECONDS=1800
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
APP_ENV=local
ENABLE_SCHEDULER=true
# Keep false unless this instance is the single chosen execution authority.
ENABLE_TRADE_EXECUTION=false
TRADING_ENABLED_DEFAULT=true
DAILY_LOSS_HALT_PCT=3.0
QUOTE_MAX_AGE_S=90
# Live equity execution requires both a live Alpaca URL and this explicit opt-in.
ALLOW_LIVE_EQUITY_EXECUTION=false

# Required for new Claude analysis. Cached results and non-LLM endpoints can run without it.
ANTHROPIC_API_KEY=
# Set true to run scans with deterministic local analysis and make zero Claude API calls.
DISABLE_CLAUDE_ANALYSIS=false

# Optional Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Keep automatic pharma shock alerts inside the consolidated terminal report.
TELEGRAM_STANDALONE_PHARMA_ALERTS=false
TELEGRAM_SINGLE_CONSOLIDATED_SCAN_ONLY=false
PUBLIC_BASE_URL=

# Optional Alpaca paper trading and market data.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
# Scanner price overlay tries Alpaca 24h/extended feeds before stale close fallbacks.
ALPACA_SCANNER_FEEDS=overnight,boats,delayed_sip,sip,iex,
SCANNER_LIVE_PRICE_MAX_AGE_SECONDS=1800
SCANNER_DELAYED_PRICE_MAX_AGE_SECONDS=1200
# Equity Trade Floor 24/5 routing. Equities only; options remain regular-session only.
# Alpaca extended-hours orders must remain limit DAY/GTC orders with extended_hours=true.
ALPACA_24H_EQUITY_ENABLED=true
ALPACA_EXECUTION_QUOTE_FEEDS=overnight,boats,delayed_sip,sip,iex,
ALPACA_EXECUTION_QUOTE_FEED=
ALPACA_ALLOW_DELAYED_24H_EXECUTION=true

# Optional separate Alpaca paper account for Options Desk.
OPTIONS_APCA_API_KEY_ID=
OPTIONS_APCA_API_SECRET_KEY=
OPTIONS_APCA_API_BASE_URL=https://paper-api.alpaca.markets
ENABLE_OPTIONS_EXECUTION=true
# Basic-plan indicative snapshots are delayed and may omit OI/greeks. This is
# paper-account-only and must remain false for any non-paper options account.
OPTIONS_ALLOW_INDICATIVE_EXECUTION=true
OPTIONS_FILTER_POLICY=standard
OPTIONS_TARGET_DELTA=0.55
OPTIONS_MAX_QUOTE_AGE_SECONDS=900
OPTIONS_MIN_OPEN_INTEREST=300
OPTIONS_MIN_VOLUME_WHEN_LOW_OI=100
OPTIONS_MIN_VOLUME_IF_OI_UNKNOWN=100
OPTIONS_MAX_SPREAD_ABS=0.75
OPTIONS_MAX_SPREAD_PCT=0.12
OPTIONS_MAX_INDICATIVE_SPREAD_PCT=0.25
OPTIONS_MIN_PREMIUM=0.05
OPTIONS_MIN_ABS_DELTA=0.35
OPTIONS_MAX_ABS_DELTA=0.75
OPTIONS_CONTRACT_LEARNING_AUTO_PROMOTE=false
OPTIONS_CONTRACT_LEARNING_LIVE_APPROVED=false
OPTIONS_ALPACA_REFRESH_LIMIT=60
OPTIONS_PM_MIN_SCORE=52
OPTIONS_PM_MIN_RR=1.10
OPTIONS_WATCH_MIN_SCORE=40
OPTIONS_WATCH_MIN_RR=1.05

# Optional Interactive Brokers Gateway/TWS market-data-only research feed.
# This adapter is never an execution broker; order mutation is blocked in code.
IBKR_ENABLED=false
IBKR_MODE=live
IBKR_DATA_ONLY=true
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=1
IBKR_ALLOW_TRADING=false
IBKR_TIMEOUT_SECONDS=8

# Optional Robinhood Agentic Trading MCP research/equity test adapter.
# OAuth must be completed by the account owner; never place username/password/2FA here.
# Keep live trading false until the MCP tool schema and read-only probe are verified.
ROBINHOOD_MCP_ENABLED=false
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_OAUTH_METADATA_URL=
ROBINHOOD_MCP_CLIENT_ID=
ROBINHOOD_TOKEN_FILE=/etc/case-capital/robinhood/oauth.json
ROBINHOOD_LIVE_TRADING=false
ROBINHOOD_REQUIRE_ORDER_REVIEW=true
ROBINHOOD_MAX_ACCOUNT_USD=100
ROBINHOOD_MAX_ORDER_USD=5
ROBINHOOD_MAX_OPEN_EXPOSURE_USD=20
ROBINHOOD_MCP_TIMEOUT_SECONDS=12

# Optional data providers.
FINNHUB_API_KEY=
MASSIVE_API_KEY=
FRED_API_KEY=
FINANCE_NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Financial Modeling Prep key used by the FinanceToolkit/FMP research adapter.
# This is research-data only until explicitly wired into a scanner/PM decision path.
FINANCIAL_MODELING_PREP_API_KEY=
FMP_API_KEY=
FINANCETOOLKIT_API_KEY=
FINANCE_TOOLKIT_RESEARCH_ENABLED=true
FMP_BASE_URL=https://financialmodelingprep.com
FMP_TIMEOUT_SECONDS=8
SAM_GOV_API_KEY=
REGULATIONS_GOV_API_KEY=
LSE_API_KEY=
