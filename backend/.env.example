MONGO_URL=mongodb://localhost:27017
DB_NAME=stock_intel
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
APP_ENV=local
ENABLE_SCHEDULER=true
# Keep false unless this instance is the single chosen execution authority.
ENABLE_TRADE_EXECUTION=false
TRADING_ENABLED_DEFAULT=true
DAILY_LOSS_HALT_PCT=3.0
QUOTE_MAX_AGE_S=90
# Live equity execution requires both a live Alpaca URL and this explicit opt-in.
ALLOW_LIVE_EQUITY_EXECUTION=false

# Required for new Claude analysis. Cached results and non-LLM endpoints can run without it.
ANTHROPIC_API_KEY=
# Set true to run scans with deterministic local analysis and make zero Claude API calls.
DISABLE_CLAUDE_ANALYSIS=false

# Optional Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# Optional Alpaca paper trading and market data.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Optional separate Alpaca paper account for Options Desk.
OPTIONS_APCA_API_KEY_ID=
OPTIONS_APCA_API_SECRET_KEY=
OPTIONS_APCA_API_BASE_URL=https://paper-api.alpaca.markets
ENABLE_OPTIONS_EXECUTION=false
OPTIONS_ALLOW_INDICATIVE_EXECUTION=false
OPTIONS_MAX_QUOTE_AGE_SECONDS=900
OPTIONS_MIN_VOLUME_IF_OI_UNKNOWN=100
OPTIONS_ALPACA_REFRESH_LIMIT=18

# Optional Interactive Brokers Gateway/TWS market-data-only research feed.
# This adapter is never an execution broker; order mutation is blocked in code.
IBKR_ENABLED=false
IBKR_MODE=live
IBKR_DATA_ONLY=true
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=1
IBKR_ALLOW_TRADING=false
IBKR_TIMEOUT_SECONDS=8

# Optional data providers.
FINNHUB_API_KEY=
MASSIVE_API_KEY=
FRED_API_KEY=
FINANCE_NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
SAM_GOV_API_KEY=
REGULATIONS_GOV_API_KEY=
LSE_API_KEY=
